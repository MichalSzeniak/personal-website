---
import { buttonBase, buttonVariants } from '../lib/button';

interface Props {
  user: string;
  domain: string;
  label: string;
}

const { user, domain, label } = Astro.props;
// The address never appears in the HTML: both parts are stored reversed and base64-encoded,
// and the script assembles them only after a click.
const encode = (part: string) => btoa([...part].reverse().join(''));
---

{/* Hidden until the script runs, so without JavaScript there is no dead button. */}
<email-reveal data-u={encode(user)} data-d={encode(domain)} hidden>
  <button type="button" class:list={[buttonBase, buttonVariants.primary]}>{label}</button>
</email-reveal>

<script>
  const decode = (value = '') => [...atob(value)].reverse().join('');

  /** Replaces the button with a mailto link to the assembled address and focuses it. */
  class EmailReveal extends HTMLElement {
    connectedCallback() {
      this.hidden = false;
      this.querySelector('button')?.addEventListener('click', () => this.reveal(), { once: true });
    }

    reveal() {
      const address = `${decode(this.dataset.u)}@${decode(this.dataset.d)}`;
      const link = document.createElement('a');
      link.href = `mailto:${address}`;
      link.textContent = address;
      // Two cells tall like the button it replaces, so nothing below moves.
      link.className =
        'inline-flex h-cells-2 items-center font-display text-[1.375rem] font-semibold text-accent underline decoration-2 underline-offset-[5px] [overflow-wrap:anywhere] hover:decoration-4';
      this.replaceChildren(link);
      link.focus();
    }
  }

  customElements.define('email-reveal', EmailReveal);
</script>
