---
import type { SectionProps } from '../lib/sections';
import Section from './Section.astro';

type Props = SectionProps;

const { id, t, facts } = Astro.props;
---

<Section id={id} title={t.sections[id]}>
  <p class="on-line-base max-w-[calc(var(--cell)*20)] text-base leading-(--cell) text-pretty">{t.about.text(facts)}</p>
</Section>
